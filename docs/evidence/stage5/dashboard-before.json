{
  "application-performance.json": {
    "uid": "cloud-lab1-application",
    "title": "Cloud Lab 1 \u2014 Application Performance",
    "description": "Stage 3: application measurements. Trace IDs and run IDs stay out of metric labels.",
    "tags": [
      "cloud-lab1",
      "stage3"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 4,
    "editable": false,
    "refresh": "5s",
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": [
        "5s",
        "10s",
        "30s",
        "1m"
      ]
    },
    "templating": {
      "list": [
        {
          "name": "service",
          "label": "Application service",
          "type": "query",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "query": "label_values(up{job=\"applications\",project=\"cloud-lab1\"},service)",
          "refresh": 1,
          "sort": 1,
          "multi": true,
          "includeAll": true,
          "allValue": ".*",
          "current": {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          "options": []
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Application scrape health",
        "description": "Exporter reachability, separate from workload and database availability. Only fresh samples are shown; retired targets remain available in historical data.",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 8,
          "h": 4
        },
        "targets": [
          {
            "refId": "A",
            "expr": "up{job=\"applications\",project=\"cloud-lab1\",service=~\"$service\"} and (timestamp(up{job=\"applications\",project=\"cloud-lab1\",service=~\"$service\"}) > time()-15)",
            "legendFormat": "{{service}}",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "noValue": "Unavailable",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 8,
              "lineWidth": 2,
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          },
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "value",
          "graphMode": "none"
        }
      },
      {
        "id": 2,
        "title": "Active experiment",
        "description": "Controller global slot. Includes starting and stopping; one experiment at a time.",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 8,
          "y": 0,
          "w": 8,
          "h": 4
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(lab_runs_active{project=\"cloud-lab1\",service=\"controller\"})",
            "legendFormat": "Active",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "noValue": "Unavailable",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 8,
              "lineWidth": 2,
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          },
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "value",
          "graphMode": "none"
        }
      },
      {
        "id": 3,
        "title": "Workload elapsed time",
        "description": "Actual reported elapsed time; unavailable while idle.",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 16,
          "y": 0,
          "w": 8,
          "h": 4
        },
        "targets": [
          {
            "refId": "A",
            "expr": "lab_workload_elapsed_seconds{project=\"cloud-lab1\",service=~\"$service\"} > 0",
            "legendFormat": "{{service}} / {{workload}}",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "noValue": "Unavailable",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 8,
              "lineWidth": 2,
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          },
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "value",
          "graphMode": "none"
        }
      },
      {
        "id": 4,
        "title": "HTTP requests by route",
        "description": "Includes browser status polling, identified by its route. Probes, scrapes and assets are excluded.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 0,
          "y": 4,
          "w": 12,
          "h": 7
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by(service,route,method) (rate(lab_http_requests_total{project=\"cloud-lab1\",service=~\"$service\"}[2m]))",
            "legendFormat": "{{service}} {{method}} {{route}}",
            "instant": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "noValue": "Unavailable",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 8,
              "lineWidth": 2,
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          },
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "value",
          "graphMode": "none"
        }
      },
      {
        "id": 5,
        "title": "HTTP p95 latency",
        "description": "Response-header latency, not asynchronous experiment duration. Sparse traffic makes percentile estimates coarse.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 12,
          "y": 4,
          "w": 12,
          "h": 7
        },
        "targets": [
          {
            "refId": "A",
            "expr": "histogram_quantile(0.95, sum by(le,service,route) (rate(lab_http_request_duration_seconds_bucket{project=\"cloud-lab1\",service=~\"$service\"}[2m])))",
            "legendFormat": "{{service}} {{route}}",
            "instant": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "noValue": "Unavailable",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 8,
              "lineWidth": 2,
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          },
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "value",
          "graphMode": "none"
        }
      },
      {
        "id": 6,
        "title": "HTTP error responses",
        "description": "4xx rejections and 5xx failures remain separately labelled.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 0,
          "y": 11,
          "w": 12,
          "h": 7
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by(service,route,status) (rate(lab_http_requests_total{project=\"cloud-lab1\",service=~\"$service\",status=~\"4..|5..\"}[2m]))",
            "legendFormat": "{{service}} {{route}} / {{status}}",
            "instant": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "noValue": "Unavailable",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 8,
              "lineWidth": 2,
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          },
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "value",
          "graphMode": "none"
        }
      },
      {
        "id": 7,
        "title": "Actual workload operation rate",
        "description": "All reported operations, regardless of trace sampling. Cycle failures and failed individual calls are distinct series, not additive totals.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 12,
          "y": 11,
          "w": 12,
          "h": 7
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by(service,workload,operation,outcome) (rate(lab_workload_operations_total{project=\"cloud-lab1\",service=~\"$service\"}[2m]))",
            "legendFormat": "{{service}} {{workload}} / {{operation}} / {{outcome}}",
            "instant": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "noValue": "Unavailable",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 8,
              "lineWidth": 2,
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          },
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "value",
          "graphMode": "none"
        }
      },
      {
        "id": 8,
        "title": "Data payload throughput",
        "description": "Payload bytes read by Data; excludes protocol overhead. Container network traffic is on the Resources dashboard.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 0,
          "y": 18,
          "w": 12,
          "h": 7
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by(service,workload) (rate(lab_workload_network_bytes_total{project=\"cloud-lab1\",service=~\"$service\"}[2m]))",
            "legendFormat": "{{service}} {{workload}}",
            "instant": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "Bps",
            "noValue": "Unavailable",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 8,
              "lineWidth": 2,
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          },
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "value",
          "graphMode": "none"
        }
      },
      {
        "id": 9,
        "title": "Workload execution p95",
        "description": "Worker process lifetime, including startup and cleanup. A single run gives a coarse histogram estimate; exact durations remain in history.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 12,
          "y": 18,
          "w": 12,
          "h": 7
        },
        "targets": [
          {
            "refId": "A",
            "expr": "histogram_quantile(0.95, sum by(le,service,workload,outcome) (rate(lab_workload_duration_seconds_bucket{project=\"cloud-lab1\",service=~\"$service\"}[2m])))",
            "legendFormat": "{{service}} {{workload}} / {{outcome}}",
            "instant": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "noValue": "Unavailable",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 8,
              "lineWidth": 2,
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          },
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "value",
          "graphMode": "none"
        }
      },
      {
        "id": 10,
        "title": "Run outcomes in displayed range",
        "description": "Controller-observed terminal transitions. Prometheus increase is extrapolated; exact experiment lists remain in history.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 0,
          "y": 25,
          "w": 12,
          "h": 7
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by(workload,outcome) (increase(lab_runs_total{project=\"cloud-lab1\",service=\"controller\"}[$__range]))",
            "legendFormat": "{{workload}} / {{outcome}}",
            "instant": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "noValue": "Unavailable",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 8,
              "lineWidth": 2,
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          },
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "value",
          "graphMode": "none"
        }
      },
      {
        "id": 11,
        "title": "I/O p95 latency",
        "description": "Full streamed network transfer or MongoDB call. Includes calls omitted from readable traces.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 12,
          "y": 25,
          "w": 12,
          "h": 7
        },
        "targets": [
          {
            "refId": "A",
            "expr": "histogram_quantile(0.95, sum by(le,service,operation,outcome) (rate(lab_workload_io_duration_seconds_bucket{project=\"cloud-lab1\",service=~\"$service\"}[2m])))",
            "legendFormat": "{{service}} {{operation}} / {{outcome}}",
            "instant": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "noValue": "Unavailable",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 8,
              "lineWidth": 2,
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          },
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "value",
          "graphMode": "none"
        }
      },
      {
        "id": 12,
        "title": "Aggregate Compute calculation throughput",
        "description": "Actual calculation units per second across Compute instances; run and batch IDs are not metric labels.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 0,
          "y": 32,
          "w": 24,
          "h": 7
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by(workload) (rate(lab_workload_operations_total{project=\"cloud-lab1\",service=~\"compute|compute-2\",operation=\"cpu_batch\",outcome=\"success\"}[2m]))",
            "legendFormat": "{{workload}} / all Compute"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "noValue": "Unavailable",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 8,
              "lineWidth": 2,
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          },
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "value",
          "graphMode": "none"
        }
      }
    ],
    "links": [
      {
        "title": "Container Resources",
        "type": "link",
        "url": "/d/cloud-lab1-resources",
        "keepTime": true,
        "targetBlank": false
      },
      {
        "title": "Explore traces",
        "type": "link",
        "url": "/explore",
        "targetBlank": true
      }
    ]
  },
  "container-resources.json": {
    "uid": "cloud-lab1-resources",
    "title": "Cloud Lab 1 \u2014 Container Resources",
    "description": "Actual resources, verified quotas, memory ceilings and throttling. Stage 4 adds explicit Compute replica comparisons.",
    "tags": [
      "cloud-lab1",
      "stage1"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 4,
    "editable": false,
    "refresh": "5s",
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": [
        "5s",
        "10s",
        "30s",
        "1m"
      ]
    },
    "templating": {
      "list": [
        {
          "name": "service",
          "label": "Service",
          "type": "query",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "query": "label_values(container_memory_working_set_bytes{project=\"cloud-lab1\",service!=\"\"}, service)",
          "refresh": 1,
          "sort": 1,
          "multi": true,
          "includeAll": true,
          "allValue": ".*",
          "current": {
            "selected": true,
            "text": [
              "compute"
            ],
            "value": [
              "compute"
            ]
          },
          "options": []
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Collection health \u00b7 cAdvisor",
        "description": "Prometheus scrape health only. This does not establish application health.",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "h": 3,
          "w": 24,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "refId": "A",
            "expr": "up{job=\"cadvisor\"}",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "noValue": "Unavailable",
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {
                    "text": "DOWN",
                    "color": "red"
                  },
                  "1": {
                    "text": "UP \u00b7 collecting container metrics",
                    "color": "green"
                  }
                }
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto",
          "textMode": "auto"
        }
      },
      {
        "id": 2,
        "title": "CPU usage \u00b7 cores",
        "type": "timeseries",
        "description": "CPU seconds per second. 1.0 means one fully occupied CPU core, not 100% of the laptop.",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 3
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (service, name) (rate(container_cpu_usage_seconds_total{project=\"cloud-lab1\",service=~\"$service\",name!=\"\",cpu=\"total\"}[30s]) and on (id) (container_last_seen{project=\"cloud-lab1\",service=~\"$service\",name!=\"\"} > time() - 15))",
            "legendFormat": "{{service}} / {{name}}",
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "suffix: cores",
            "min": 0,
            "noValue": "Unavailable",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 12,
              "showPoints": "never",
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "options": {
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "calcs": [
              "lastNotNull",
              "max"
            ]
          }
        }
      },
      {
        "id": 3,
        "title": "Memory working set \u00b7 MiB",
        "type": "timeseries",
        "description": "Container working set includes the server and its child process; it is not just the requested allocation.",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 3
        },
        "targets": [
          {
